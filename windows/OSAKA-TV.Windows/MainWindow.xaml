<Window x:Class="OSAKA_TV.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="OSAKA TV" Height="820" Width="1440" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#080808" Foreground="White">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Background="#111" LastChildFill="True">
      <TextBlock Text="OSAKA TV" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="22,0,28,0"/>
      <TextBlock Text="LIVE TELEVISION" Foreground="#E62117" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,4,24,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBox x:Name="SearchBox" Width="230" Height="34" VerticalContentAlignment="Center" Padding="8" Background="#252525" Foreground="White" BorderBrush="#444" TextChanged="SearchBox_TextChanged"/>
        <Button Content="Open playlist" Click="OpenPlaylist_Click"/>
        <Button Content="Refresh" Click="Refresh_Click"/>
        <Button Content="★ Favourites" Click="Favourites_Click"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#151515" CornerRadius="8" Margin="0,0,8,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="8,8,8,12"/>
          <ListBox x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="#151515" CornerRadius="8" Margin="0,0,8,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="CHANNELS" Foreground="#999" FontSize="11" FontWeight="Bold" Margin="8,8,8,12"/>
          <ListBox x:Name="ChannelList" SelectionChanged="ChannelList_SelectionChanged" DisplayMemberPath="Title"/>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#000" CornerRadius="8" ClipToBounds="True">
          <vlc:VideoView x:Name="VideoView"/>
        </Border>
        <Border Grid.Row="1" Background="#151515" CornerRadius="8" Margin="0,8,0,0" Padding="14">
          <DockPanel>
            <StackPanel>
              <TextBlock x:Name="NowPlayingText" Text="Choose a channel to start watching" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatusText" Text="Ready" Foreground="#AAA" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="Play" Click="Play_Click"/>
              <Button Content="Stop" Click="Stop_Click"/>
              <Button x:Name="FavoriteButton" Content="☆ Favourite" Click="Favorite_Click"/>
              <Button Content="Full screen (F11)" Click="Fullscreen_Click"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#111" Padding="10,4">
      <TextBlock x:Name="FooterText" Text="OSAKA TV • Windows 11" Foreground="#888" FontSize="10"/>
    </Border>
  </Grid>
</Window>