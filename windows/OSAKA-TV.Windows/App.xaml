<Application x:Class="OSAKA_TV.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#080808"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#151515"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E62117"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#292929"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#151515"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </Application.Resources>
</Application>